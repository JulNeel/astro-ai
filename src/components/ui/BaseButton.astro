---
interface Props {
  variant?: "primary" | "secondary" | "tertiary" | "outline" | "white";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  outlineColor?: "primary" | "secondary" | "tertiary" | "white";
  href?: string;
  target?: "_blank" | "_self" | "_parent" | "_top";
  rel?: string;
  ariaLabel?: string;
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: extraClass = "",
  outlineColor = "primary",
  href,
  target,
  rel,
  ariaLabel,
} = Astro.props;

const isLink = !!href;
const ItemWrapper = isLink ? "a" : "button";

const base =
  "inline-flex items-center justify-center font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed";

const variantClasses = {
  primary: "bg-primary text-white hover:bg-primary/90 focus:ring-primary",
  secondary: "bg-secondary text-white hover:bg-secondary/90 focus:ring-secondary",
  tertiary: "bg-tertiary text-white hover:bg-tertiary/90 focus:ring-tertiary",
  white: "bg-white text-black hover:bg-white/70  focus:ring-primary",
  outline: {
    primary:
      "border border-primary text-primary bg-transparent hover:bg-primary/80 hover:text-white focus:ring-primary hover:border-transparent",
    secondary:
      "border border-secondary text-secondary bg-transparent hover:bg-secondary/80 hover:text-white focus:ring-secondary hover:border-transparent",
    tertiary:
      "border border-tertiary text-tertiary bg-transparent hover:bg-tertiary/80 hover:text-white focus:ring-tertiary hover:border-transparent",
    white:
      "border border-white text-white bg-transparent hover:bg-white hover:text-black focus:ring-white hover:border-transparent",
  },
};

const sizeClasses = {
  sm: "text-sm px-8 py-2",
  md: "text-xl px-12 py-4",
  lg: "text-3xl px-16 py-6",
};

const variantClass = variant === "outline" ? variantClasses.outline[outlineColor] : variantClasses[variant];
const sizeClass = sizeClasses[size];

const className = `${base} ${variantClass} ${sizeClass} ${extraClass}`.trim();

const linkAttrs = isLink
  ? {
      href,
      ...(target && { target }),
      ...(rel && { rel }),
      ...(target === "_blank" && !rel && { rel: "noopener noreferrer" }),
      ...(disabled && { "aria-disabled": "true", tabindex: "-1" }),
    }
  : {};

const buttonAttrs = !isLink
  ? {
      type,
      disabled,
    }
  : {};

const commonAttrs = {
  class: className,
  ...(ariaLabel && { "aria-label": ariaLabel }),
};
---

<ItemWrapper {...commonAttrs} {...linkAttrs} {...buttonAttrs}>
  <slot />
</ItemWrapper>

<style>
  /* Style pour les liens désactivés */
  a[aria-disabled="true"] {
    pointer-events: none;
  }
</style>

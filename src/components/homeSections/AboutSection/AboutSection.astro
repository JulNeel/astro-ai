---
import AboutCard from "@components/homeSections/aboutSection/AboutCard.astro";
import HomeSectionLayout from "@components/layout/HomeSectionLayout.astro";
import SectionPost from "@components/layout/SectionPost.astro";
import BaseCarousel, { CarouselItem } from "@components/ui/BaseCarousel";
import BaseIconsList from "@components/ui/BaseIconsList.astro";
import imageNumberThree from "@images/three.svg";
import { useTranslations } from "@locales/utils/useTranslations";
import type { IconListItem } from "@ts/iconListItem.type";
import type { Reviewer } from "@ts/reviewers.type";
import dots from "@images/dots.svg";

const { lang = "en" } = Astro.params;
const t = await useTranslations(lang);
const reviewers = await import(`../../../content/${lang}/about/reviewers.json`);
const post = await import(`../../../content/${lang}/about/aboutPost.mdx`);
const { default: partnersItems }: { default: IconListItem[] } = await import(
  `../../../content/${lang}/about/partners.json`
);
const partnersImages = import.meta.glob<{ default: ImageMetadata }>("../../../images/partners/*.svg", {
  eager: true,
});

const partnersMappedItems: IconListItem[] = partnersItems.map((item) => {
  const icon = partnersImages[`../../../images/partners${item.iconPath}`];
  return {
    ...item,
    iconSource: icon?.default.src ?? "",
  };
});
---

<HomeSectionLayout
  id="about"
  title={t("about-section.heading.title")}
  baseLine={t("about-section.heading.baseline")}
  numberIconData={imageNumberThree}
  sectionNumber={3}
  titleColor="text-tertiary"
  extraClass={`bg-black relative bg-center bg-[url("/images/dots.svg")] bg-top-right bg-no-repeat`}
>
  <BaseCarousel itemWidth={300} gap={16} client:load lang={lang}>
    {
      reviewers.default.map((reviewer: Reviewer) => (
        <CarouselItem width={300}>
          <AboutCard {...reviewer} />
        </CarouselItem>
      ))
    }
  </BaseCarousel>
  <div class="mx-auto mt-16 lg:mr-auto lg:ml-0 lg:max-w-3/4">
    <SectionPost>
      <post.Content />
    </SectionPost>
  </div>
  <div class="mt-16 rounded-md bg-gray-800 px-8">
    <div class="flex flex-col items-stretch p-2 md:flex-row md:items-center">
      <h3 class="mt-4 mr-16 shrink-0 text-xl font-bold text-white md:mr-24 md:text-3xl lg:mr-32 lg:text-4xl">
        {t("about-section.heading.partnersTitle")}
      </h3>
      <BaseIconsList items={partnersMappedItems} iconsSize="m" wrap />
    </div>
  </div>
</HomeSectionLayout>

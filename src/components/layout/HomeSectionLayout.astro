---
import { type SvgComponent } from "astro/types";
import { Image } from "astro:assets";
import Container from "@components/layout/Container.astro";

interface Props {
  id: string;
  title: string;
  baseLine: string;
  numberIconData: SvgComponent & ImageMetadata;
  sectionNumber: number;
  titleColor?: string;
  extraClass?: string;
}

const {
  id,
  title = "a title for the section",
  baseLine = "a baseLine for the section",
  numberIconData,
  sectionNumber,
  titleColor = "text-primary",
  extraClass,
} = Astro.props;
---

<section class:list={["min-h-screen flex", extraClass]} id={id}>
  <Container variant="constrained" class="py-8 lg:pb-12 lg:pt-24 flex flex-col">
    <div class="text-white flex gap-x-8 mb-8">
      <Image class="max-h-16 md:max-h-24 mb-auto mt-4" src={numberIconData} alt={JSON.stringify(sectionNumber)} />
      <div class="flex flex-col">
        <h2 class=`h2 ${titleColor} col-start-2 col-end-6 md:leading-tight whitespace-pre-line`>
          {title}
        </h2>
        <span class="text-base leading-8 col-start-2 col-end-6 font-light">{baseLine}</span>
      </div>
    </div>
    <div class="mb-12 flex flex-col flex-1 justify-around">
      <slot />
    </div>
  </Container>
</section>
